{
  "name": "dsh-motionworks-iec-use",
  "version": "0.4.2",
  "description": "Workspace-bound MotionWorks IEC editing, versioned programming references, static review and IDE verification for AryaAI DSH.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "motionworks",
    "yaskawa",
    "iec-61131-3",
    "plc",
    "industrial-automation"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "preflight.mjs",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "bridge/",
    "code/",
    "docs/",
    "!**/__pycache__/",
    "!**/*.pyc",
    "!bridge/req.json",
    "!bridge/res.json",
    "!bridge/bridge.log",
    "!code/req.json",
    "!code/res.json",
    "!code/res_*.json",
    "test/workspace*.mjs",
    "test/close_consent.mjs",
    "test/workspace*.py",
    "test/workspace*.ps1",
    "test/mwt_fixture.mjs",
    "test/skill_delivery.mjs",
    "!code/req-*.json",
    "!code/res-*.json",
    "test/reliability_test.py",
    "test/native_reference.py",
    "WORKFLOW.md",
    "!code/req*.json",
    "!code/res*.json",
    "test/knowledge_test.py",
    "test/knowledge_tools.mjs",
    "!bridge/*.lock"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/workspace_suite.mjs",
    "test:contract": "node test/render_contract.mjs",
    "test:workspace": "node test/workspace_suite.mjs",
    "test:selfcontained": "node test/selfcontained.mjs",
    "test:live": "node test/verbs.mjs",
    "test:loop": "node test/code_loop.mjs",
    "test:smoke": "node test/smoke_test.mjs",
    "preflight": "node preflight.mjs",
    "test:preflight": "node preflight.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KonnectSuite/dsh-motionworks-iec-use.git"
  },
  "bugs": {
    "url": "https://github.com/KonnectSuite/dsh-motionworks-iec-use/issues"
  },
  "homepage": "https://github.com/KonnectSuite/dsh-motionworks-iec-use#readme"
}
